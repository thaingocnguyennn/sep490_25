generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentStatus {
  DRAFT // Bản nháp
  PENDING // Chờ xử lý (văn bản đến)
  IN_PROGRESS // Đang xử lý
  SUBMITTED // Đã trình duyệt (văn bản đi - chờ trưởng phòng duyệt)
  RETURNED // Trả lại để chỉnh sửa
  APPROVED // Đã duyệt (trưởng phòng duyệt)
  REGISTERED // Đã vào sổ (văn thư đã cấp số, chờ phát hành)
  WAITING_FOR_ISSUE // Chờ văn thư cấp số và phát hành
  ISSUED // Đã phát hành
  COMPLETED // Hoàn tất
  RECALLED // Thu hồi
  TRASHED // Đã chuyển vào thùng rác
  REJECTED // Bị từ chối
  CANCELLED // Đã huỷ
}

// Loại sổ văn bản
enum DocumentBookType {
  INCOMING // Sổ văn bản đến
  OUTGOING // Sổ văn bản đi
}

// Trạng thái sổ văn bản
enum DocumentBookStatus {
  ACTIVE   // Đang hoạt động
  CLOSED   // Đã đóng sổ (cuối năm)
  INACTIVE // Vô hiệu hóa
}

enum ProcessorType {
  XLC // Primary Processor
  PHXL // Coordinating Processor
  XDB // For Information/Reference Only
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum DocumentType {
  INCOMING
  OUTGOING
  INTERNAL
  ARCHIVAL
}

// Document lifecycle status (ACTIVE or soft-deleted)
enum DocumentLifecycleStatus {
  ACTIVE
  DELETED
}

enum DocumentCategoryStatus {
  ACTIVE
  INACTIVE
}

enum DocumentKindStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  parentId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primaryUserId Int?

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[] @relation("DepartmentHierarchy")
  primaryUser User?     @relation("DepartmentPrimaryUser", fields: [primaryUserId], references: [id])

  // Many-to-many: a user can belong to multiple departments, and a department can have multiple users
  members           DepartmentMember[]
  documents         Document[]         @relation("DocumentDepartment")
  incomingDocuments IncomingDocument[]
  User              User[]
  documentBooks     DocumentBook[]

  @@unique([name, parentId])
  @@index([parentId])
  @@index([primaryUserId])
}

model DepartmentMember {
  userId       Int
  departmentId Int
  assignedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  password     String
  passwordChangedAt DateTime?
  passwordResetTokens PasswordResetToken[]
  fullName     String
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  lastLogin    DateTime?
  lockUntil    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    Int?
  updatedBy    Int?

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  departmentMemberships DepartmentMember[]
  primaryDepartments    Department[]  @relation("DepartmentPrimaryUser")

  userRoles     UserRole[]
  createdByUser User?      @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers  User[]     @relation("CreatedBy")
  updatedByUser User?      @relation("UpdatedBy", fields: [updatedBy], references: [id])
  updatedUsers  User[]     @relation("UpdatedBy")

  notifications      Notification[]
  documentWorkflows  DocumentWorkflow[]
  createdDocuments   Document[]          @relation("CreatedBy")
  updatedDocuments   Document[]          @relation("UpdatedBy")
  processedDocuments Document[]          @relation("DocumentProcessor")
  documentProcessors DocumentProcessor[]

  // Outgoing document workflow relations
  outgoingSubmitted        OutgoingDocument[] @relation("OutgoingSubmittedBy")
  outgoingApproved         OutgoingDocument[] @relation("OutgoingApprovedBy")
  outgoingReturned  OutgoingDocument[] @relation("OutgoingReturnedBy")
  outgoingForwarded OutgoingDocument[] @relation("OutgoingForwardedBy")
  outgoingIssued    OutgoingDocument[] @relation("OutgoingIssuedBy")
  outgoingRecalled  OutgoingDocument[] @relation("OutgoingRecalledBy")
  outgoingTrashed   OutgoingDocument[] @relation("OutgoingTrashedBy")

  outgoingAssignedApprover OutgoingDocument[] @relation("OutgoingAssignedApprover")
  outgoingAssignedClerk    OutgoingDocument[] @relation("OutgoingAssignedClerk")

  incomingDocumentsCreated IncomingDocument[]      @relation("IncomingDocumentClerk")
  incomingDocumentComments IncomingDocumentComment[]

  // Document book relations
  createdDocumentBooks         DocumentBook[]      @relation("DocumentBookCreatedBy")
  registeredIncomingEntries    IncomingBookEntry[] @relation("IncomingEntryRegisteredBy")
  acknowledgedIncomingEntries  IncomingBookEntry[] @relation("IncomingEntryAcknowledgedBy")
  registeredOutgoingEntries    OutgoingBookEntry[] @relation("OutgoingEntryRegisteredBy")

  // Document category relations
  createdDocumentCategories DocumentCategory[] @relation("DocumentCategoryCreatedBy")
  updatedDocumentCategories DocumentCategory[] @relation("DocumentCategoryUpdatedBy")

  // Document type (kind) relations
  createdDocumentKinds DocumentKind[] @relation("DocumentKindCreatedBy")
  updatedDocumentKinds DocumentKind[] @relation("DocumentKindUpdatedBy")

  @@index([departmentId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles UserRole[]
}

// Lookup table for document confidentiality classifications
// (replaces the previous ConfidentialityLevel enum)
model Confidentiality {
  id          Int      @id @default(autoincrement())
  code        String?  @unique // Optional document code (A, B, C) — null for THUONG
  name        String   @unique // Vietnamese label: TUYET_MAT, TOI_MAT, MAT, THUONG
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
}

// Lookup table for document urgency levels
// (replaces the previous Urgency enum used by IncomingDocument/OutgoingDocument)
model Urgency {
  id          Int      @id @default(autoincrement())
  name        String   @unique // THUONG, KHAN, THUONG_KHAN, HOA_TOC
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents         Document[]
}

model UserRole {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Document {
  id             Int            @id @default(autoincrement())
  documentNumber String         @unique
  title          String
  description    String?
  type           DocumentType
  fileUrl        String?
  ocrText        String?
  ocrStatus      OcrStatus      @default(PENDING)
  status         DocumentStatus @default(DRAFT)
  deadline       DateTime?
  searchVector   Unsupported("tsvector")? // Full-text search: title + description + ocrText

  // --- Level 2 fields: basic document management ---
  issuanceDate      DateTime? // Ngày ban hành
  sendingAgency     String? // Cơ quan gửi
  urgencyId         Int? // FK -> Urgency (mức độ khẩn)
  confidentialityId Int? // FK -> Confidentiality (mức độ mật)
  documentStatus    DocumentLifecycleStatus @default(ACTIVE) // Trạng thái soft-delete
  category          String? // Phân loại phụ (tuỳ chọn)
  originalFileName  String? // Tên file gốc khi upload
  fileSize          Int? // Dung lượng file (bytes)
  mimeType          String? // Loại MIME (application/pdf, ...)
  isArchived        Boolean                 @default(false) // Đã lưu trữ

  // Department & processor relations
  departmentId Int?
  department   Department? @relation("DocumentDepartment", fields: [departmentId], references: [id])
  processorId  Int?
  processor    User?       @relation("DocumentProcessor", fields: [processorId], references: [id])

  // Confidentiality & urgency relations
  confidentiality Confidentiality? @relation(fields: [confidentialityId], references: [id])
  urgency         Urgency?         @relation(fields: [urgencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  createdByUser     User?                @relation("CreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?                @relation("UpdatedBy", fields: [updatedBy], references: [id])
  incomingDocuments IncomingDocument[]
  outgoingDocuments OutgoingDocument[]
  workflows         DocumentWorkflow[]
  processors        DocumentProcessor[]
  attachments       DocumentAttachment[]
  incomingComments  IncomingDocumentComment[]

  @@index([documentStatus])
  @@index([type])
  @@index([departmentId])
  @@index([processorId])
  @@index([confidentialityId])
  @@index([urgencyId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([ocrStatus])
  @@index([deadline])
  @@index([isArchived])
  @@index([searchVector], type: Gin)
}

model IncomingDocument {
  id                     Int       @id @default(autoincrement())
  documentId             Int       @unique
  issuer                 String? // Cơ quan ban hành
  documentType           String? // Loại văn bản cũ (String, giữ tạm trong giai đoạn chuyển đổi)
  documentNumber         String? // Số ký hiệu văn bản
  arrivalNumber          Int? // Số đến (do DocumentBook cấp, không gán thủ công)
  signerName             String? // Họ tên người ký
  signerTitle            String? // Chức vụ người ký
  dateLetter             DateTime? // Ngày, tháng, năm văn bản
  dateReceived           DateTime // Ngày đến
  summary                String?   @db.Text // Trích yếu nội dung
  pageCount              Int? // Số trang văn bản
  notes                  String?
  processingInstructions String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Liên kết sổ văn bản đến
  documentBookId Int?
  documentBook   DocumentBook? @relation("IncomingDocumentBook", fields: [documentBookId], references: [id])

  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?

  createdByClerk   User? @relation("IncomingDocumentClerk", fields: [createdByClerkId], references: [id])
  createdByClerkId Int?

  categoryId Int?
  category   DocumentCategory? @relation(fields: [categoryId], references: [id])

  // FK mới sang bảng DocumentKind (thay thế field String cũ)
  documentTypeId  Int?
  documentTypeRef DocumentKind? @relation("IncomingDocumentKind", fields: [documentTypeId], references: [id])

  outgoingResponses   OutgoingDocument[]
  comments            IncomingDocumentComment[]
  bookEntry           IncomingBookEntry?

  @@index([categoryId])
  @@index([documentTypeId])
  @@index([createdByClerkId])
  @@index([departmentId])
  @@index([dateReceived])
  @@index([arrivalNumber])
  @@index([documentBookId])
}

model OutgoingDocument {
  id         Int @id @default(autoincrement())
  documentId Int @unique

  // Thông tin cơ bản văn bản đi
  documentType   String? // Loại văn bản cũ (String, giữ tạm trong giai đoạn chuyển đổi)
  documentNumber String? // Số ký hiệu văn bản gốc
  dispatchNumber String? // Số phát hành chính thức (officialNumber, do DocumentBook cấp)
  issuanceDate   DateTime? // Ngày ban hành chính thức
  signerName     String? // Họ tên người ký
  signerTitle    String? // Chức vụ người ký

  // Thông tin phát hành
  recipientName    String? // Tên người/cơ quan nhận
  recipientAddress String? // Địa chỉ người nhận
  recipientEmail   String? // Email người nhận
  sentDate         DateTime? // Ngày gửi/phát hành
  pageCount        Int? // Số trang

  // Liên kết sổ văn bản đi
  documentBookId Int?
  documentBook   DocumentBook? @relation("OutgoingDocumentBook", fields: [documentBookId], references: [id])

  // Workflow notes
  relatedIncomingDocumentId Int?
  relatedIncomingDocument   IncomingDocument? @relation(fields: [relatedIncomingDocumentId], references: [id])

  submittedAt  DateTime? // Thời điểm trình duyệt
  submittedBy  Int? // Người trình duyệt
  approvedAt   DateTime? // Thời điểm duyệt
  approvedBy   Int? // Người duyệt
  returnedAt   DateTime? // Thời điểm trả lại
  returnedBy   Int? // Người trả lại
  returnReason String? // Lý do trả lại
  forwardedAt  DateTime? // Thời điểm chuyển văn thư
  forwardedBy  Int? // Người chuyển văn thư
  issuedAt     DateTime? // Thời điểm phát hành
  issuedBy     Int? // Người phát hành
  recalledAt   DateTime? // Thời điểm thu hồi
  recalledBy   Int? // Người thu hồi
  recallReason String? // Lý do thu hồi
  trashedAt    DateTime? // Thời điểm đưa vào thùng rác
  trashedBy    Int? // Người đưa vào thùng rác

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  submittedByUser User?    @relation("OutgoingSubmittedBy", fields: [submittedBy], references: [id])
  approvedByUser  User?    @relation("OutgoingApprovedBy", fields: [approvedBy], references: [id])
  returnedByUser  User?    @relation("OutgoingReturnedBy", fields: [returnedBy], references: [id])
  forwardedByUser User?    @relation("OutgoingForwardedBy", fields: [forwardedBy], references: [id])
  issuedByUser    User?    @relation("OutgoingIssuedBy", fields: [issuedBy], references: [id])
  recalledByUser  User?    @relation("OutgoingRecalledBy", fields: [recalledBy], references: [id])
  trashedByUser   User?    @relation("OutgoingTrashedBy", fields: [trashedBy], references: [id])

  assignedApproverId Int?
  assignedApprover   User? @relation("OutgoingAssignedApprover", fields: [assignedApproverId], references: [id])
  assignedClerkId    Int?
  assignedClerk      User? @relation("OutgoingAssignedClerk", fields: [assignedClerkId], references: [id])

  categoryId Int?
  category   DocumentCategory? @relation(fields: [categoryId], references: [id])

  // FK mới sang bảng DocumentKind (thay thế field String cũ)
  documentTypeId  Int?
  documentTypeRef DocumentKind? @relation("OutgoingDocumentKind", fields: [documentTypeId], references: [id])

  bookEntry OutgoingBookEntry?

  @@index([categoryId])
  @@index([documentTypeId])
  @@index([relatedIncomingDocumentId])
  @@index([dispatchNumber])
  @@index([assignedApproverId])
  @@index([assignedClerkId])
  @@index([documentBookId])
}

model DocumentProcessor {
  id            Int           @id @default(autoincrement())
  documentId    Int
  userId        Int
  processorType ProcessorType
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId, processorType])
  @@index([userId])
}

// History of every assignment per document — used for audit and undo.
model DocumentProcessorHistory {
  id            Int           @id @default(autoincrement())
  documentId    Int
  userId        Int
  processorType ProcessorType
  action        String        // ASSIGNED | TRANSFERRED | REMOVED | COMPLETED
  reason        String?
  actorId       Int?
  createdAt     DateTime      @default(now())

  @@index([documentId])
  @@index([userId])
}

// Comment thread per incoming document — supports XLC / PHXL discussions.
model IncomingDocumentComment {
  id            Int      @id @default(autoincrement())
  incomingId    Int
  documentId    Int
  userId        Int
  body          String   @db.Text
  createdAt     DateTime @default(now())

  incoming IncomingDocument @relation(fields: [incomingId], references: [id], onDelete: Cascade)
  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([incomingId, createdAt])
}

model DocumentAttachment {
  id         Int      @id @default(autoincrement())
  documentId Int
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model WorkflowStep {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  stepOrder   Int      @default(1)
  roleName    String? // Optional: restrict this step to a specific role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflows DocumentWorkflow[]
}

model DocumentWorkflow {
  id             Int            @id @default(autoincrement())
  documentId     Int
  workflowStepId Int
  userId         Int?
  status         WorkflowStatus @default(PENDING)
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([documentId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SystemLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String?
  entityId   Int?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Document Book Models ──────────────────────────────────────────────────────

// So dang ky van ban theo Nghi dinh 30/2020/ND-CP.
// Mot so thuoc ve mot phong ban, mot loai (den/di), mot nam.
// So den/so van ban di duoc cap tuan tu trong pham vi so.
model DocumentBook {
  id            Int                @id @default(autoincrement())
  name          String             // VD: "Sổ văn bản đến 2026 - Phòng Hành chính"
  code          String?            // Ký hiệu sổ (tuỳ chọn)
  description   String?            // Ghi chú mô tả
  bookType      DocumentBookType
  year          Int                // Năm quản lý (VD: 2026)
  currentNumber Int                @default(0) // Số hiện tại (tự động tăng, không sửa trực tiếp)
  isDefault     Boolean            @default(false) // Sổ mặc định của dept+type+year
  status        DocumentBookStatus @default(ACTIVE)

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  createdById Int
  createdBy   User @relation("DocumentBookCreatedBy", fields: [createdById], references: [id])

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  deletedAt DateTime? // Soft-delete: sổ chưa dùng bị xóa sẽ set field này
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  incomingEntries  IncomingBookEntry[]
  outgoingEntries  OutgoingBookEntry[]
  incomingDocuments IncomingDocument[] @relation("IncomingDocumentBook")
  outgoingDocuments OutgoingDocument[] @relation("OutgoingDocumentBook")

  // Trong cùng dept + type + year, tên phải duy nhất
  @@unique([departmentId, bookType, year, name])
  @@index([departmentId, bookType, year, status])
  @@index([isDefault])
}

// Entry cua so van ban den.
// Luu snapshot tai thoi diem dang ky de bao toan lich su.
// Mot van ban den chi duoc dang ky vao mot so duy nhat.
model IncomingBookEntry {
  id                 Int      @id @default(autoincrement())

  documentBookId     Int
  documentBook       DocumentBook     @relation(fields: [documentBookId], references: [id])

  incomingDocumentId Int              @unique
  incomingDocument   IncomingDocument @relation(fields: [incomingDocumentId], references: [id])

  // Số đến được cấp bởi transaction atomic
  arrivalNumber Int
  arrivalDate   DateTime

  // Snapshot tại thời điểm đăng ký (bảo toàn lịch sử khi metadata thay đổi)
  senderSnapshot             String   // Cơ quan gửi
  documentNumberSnapshot     String?  // Số ký hiệu văn bản
  documentSymbolSnapshot     String?  // Ký hiệu văn bản
  documentDateSnapshot       DateTime? // Ngày văn bản
  documentTypeSnapshot       String?  // Loại văn bản
  summarySnapshot            String   @db.Text // Trích yếu
  assignedDepartmentSnapshot String?  // Đơn vị nhận
  assignedUserSnapshot       String?  // Người nhận

  // Theo dõi chuyển giao
  transferDate     DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  acknowledgedBy   User?   @relation("IncomingEntryAcknowledgedBy", fields: [acknowledgedById], references: [id])

  note String? @db.Text

  registeredById Int
  registeredBy   User     @relation("IncomingEntryRegisteredBy", fields: [registeredById], references: [id])
  registeredAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  // Một sổ không được có hai entry cùng số đến
  @@unique([documentBookId, arrivalNumber])
  @@index([arrivalDate])
  @@index([documentBookId])
  @@index([registeredById])
}

// Entry cua so van ban di.
// Luu snapshot va so chinh thuc duoc cap tai thoi diem dang ky.
// Mot van ban di chi duoc dang ky vao mot so duy nhat.
model OutgoingBookEntry {
  id                 Int      @id @default(autoincrement())

  documentBookId     Int
  documentBook       DocumentBook     @relation(fields: [documentBookId], references: [id])

  outgoingDocumentId Int              @unique
  outgoingDocument   OutgoingDocument @relation(fields: [outgoingDocumentId], references: [id])

  // Số thứ tự và số văn bản chính thức (VD: 001/QĐ-DMS)
  sequenceNumber Int
  officialNumber String   // Số văn bản đi chính thức
  documentSymbol String?  // Ký hiệu văn bản
  issuanceDate   DateTime // Ngày ban hành

  // Snapshot tại thời điểm đăng ký
  documentTypeSnapshot     String?  // Loại văn bản
  summarySnapshot          String   @db.Text // Trích yếu
  signerSnapshot           String?  // Người ký
  recipientsSnapshot       String   @db.Text // Nơi nhận
  archiveRecipientSnapshot String?  // Đơn vị/người nhận bản lưu
  copyCount                Int      @default(1) // Số lượng bản

  // Theo dõi chuyển giao
  transferDate   DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?

  note String? @db.Text

  registeredById Int
  registeredBy   User     @relation("OutgoingEntryRegisteredBy", fields: [registeredById], references: [id])
  registeredAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  // Trong cùng một sổ, số thứ tự và số chính thức phải duy nhất
  @@unique([documentBookId, sequenceNumber])
  @@unique([documentBookId, officialNumber])
  @@index([issuanceDate])
  @@index([documentBookId])
  @@index([registeredById])
}

model DocumentKind {
  id             Int                @id @default(autoincrement())
  name           String
  normalizedName String             @unique
  code           String             @unique
  description    String?
  status         DocumentKindStatus @default(ACTIVE)

  isSystem       Boolean            @default(false)
  deletedAt      DateTime?

  createdById    Int
  updatedById    Int?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  createdBy User  @relation("DocumentKindCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("DocumentKindUpdatedBy", fields: [updatedById], references: [id])

  incomingDocuments IncomingDocument[] @relation("IncomingDocumentKind")
  outgoingDocuments OutgoingDocument[] @relation("OutgoingDocumentKind")

  @@index([status, deletedAt])
  @@index([name])
  @@index([code])
}

model DocumentCategory {
  id             Int                    @id @default(autoincrement())
  name           String
  normalizedName String                 @unique
  code           String                 @unique
  description    String?
  status         DocumentCategoryStatus @default(ACTIVE)

  isSystem       Boolean                @default(false)
  deletedAt      DateTime?

  createdById    Int
  updatedById    Int?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  createdBy User @relation("DocumentCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("DocumentCategoryUpdatedBy", fields: [updatedById], references: [id])

  incomingDocuments IncomingDocument[]
  outgoingDocuments OutgoingDocument[]

  @@index([status, deletedAt])
  @@index([name])
  @@index([code])
}
