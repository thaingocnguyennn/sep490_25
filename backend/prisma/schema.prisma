generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentStatus {
  DRAFT // Bản nháp
  PENDING // Chờ xử lý (văn bản đến)
  IN_PROGRESS // Đang xử lý
  SUBMITTED // Đã trình duyệt (văn bản đi - chờ trưởng phòng duyệt)
  RETURNED // Trả lại để chỉnh sửa
  APPROVED // Đã duyệt (trưởng phòng duyệt)
  WAITING_FOR_ISSUE // Chờ văn thư cấp số và phát hành
  ISSUED // Đã phát hành
  COMPLETED // Hoàn tất
  RECALLED // Thu hồi
  TRASHED // Đã chuyển vào thùng rác
  REJECTED // Bị từ chối
  CANCELLED // Đã huỷ
}

enum ProcessorType {
  XLC // Primary Processor
  PHXL // Coordinating Processor
  XDB // For Information/Reference Only
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum DocumentType {
  INCOMING
  OUTGOING
  INTERNAL
  ARCHIVAL
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Document lifecycle status (ACTIVE or soft-deleted)
enum DocumentLifecycleStatus {
  ACTIVE
  DELETED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  parentId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[] @relation("DepartmentHierarchy")

  // Many-to-many: a user can belong to multiple departments, and a department can have multiple users
  members           DepartmentMember[]
  documents         Document[]         @relation("DocumentDepartment")
  incomingDocuments IncomingDocument[]
  User              User[]

  @@unique([name, parentId])
  @@index([parentId])
}

model DepartmentMember {
  userId       Int
  departmentId Int
  assignedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@index([userId])
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  password     String
  fullName     String
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  lastLogin    DateTime?
  lockUntil    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    Int?
  updatedBy    Int?

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  departmentMemberships DepartmentMember[]

  userRoles     UserRole[]
  createdByUser User?      @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers  User[]     @relation("CreatedBy")
  updatedByUser User?      @relation("UpdatedBy", fields: [updatedBy], references: [id])
  updatedUsers  User[]     @relation("UpdatedBy")

  notifications      Notification[]
  documentWorkflows  DocumentWorkflow[]
  createdDocuments   Document[]          @relation("CreatedBy")
  updatedDocuments   Document[]          @relation("UpdatedBy")
  processedDocuments Document[]          @relation("DocumentProcessor")
  documentProcessors DocumentProcessor[]

  // Outgoing document workflow relations
  outgoingSubmitted OutgoingDocument[] @relation("OutgoingSubmittedBy")
  outgoingApproved  OutgoingDocument[] @relation("OutgoingApprovedBy")
  outgoingReturned  OutgoingDocument[] @relation("OutgoingReturnedBy")
  outgoingForwarded OutgoingDocument[] @relation("OutgoingForwardedBy")
  outgoingIssued    OutgoingDocument[] @relation("OutgoingIssuedBy")
  outgoingRecalled  OutgoingDocument[] @relation("OutgoingRecalledBy")
  outgoingTrashed   OutgoingDocument[] @relation("OutgoingTrashedBy")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles UserRole[]
}

// Lookup table for document confidentiality classifications
// (replaces the previous ConfidentialityLevel enum)
model Confidentiality {
  id          Int      @id @default(autoincrement())
  code        String?  @unique // Optional document code (A, B, C) — null for THUONG
  name        String   @unique // Vietnamese label: TUYET_MAT, TOI_MAT, MAT, THUONG
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
}

// Lookup table for document urgency levels
// (replaces the previous Urgency enum used by IncomingDocument/OutgoingDocument)
model Urgency {
  id          Int      @id @default(autoincrement())
  name        String   @unique // THUONG, KHAN, THUONG_KHAN, HOA_TOC
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents         Document[]
  incomingDocuments IncomingDocument[]
  outgoingDocuments OutgoingDocument[]
}

model UserRole {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Document {
  id             Int            @id @default(autoincrement())
  documentNumber String         @unique
  title          String
  description    String?
  type           DocumentType
  fileUrl        String?
  ocrText        String?
  ocrStatus      OcrStatus      @default(PENDING)
  status         DocumentStatus @default(DRAFT)
  priority       Priority       @default(NORMAL)
  deadline       DateTime?

  // --- Level 2 fields: basic document management ---
  issuanceDate      DateTime? // Ngày ban hành
  sendingAgency     String? // Cơ quan gửi
  urgencyLevel      Priority                @default(NORMAL) // Mức độ khẩn (derived from urgency)
  urgencyId         Int? // FK -> Urgency (canonical urgency)
  confidentialityId Int? // FK -> Confidentiality (mức độ mật)
  documentStatus    DocumentLifecycleStatus @default(ACTIVE) // Trạng thái soft-delete
  category          String? // Phân loại phụ (tuỳ chọn)
  originalFileName  String? // Tên file gốc khi upload
  fileSize          Int? // Dung lượng file (bytes)
  mimeType          String? // Loại MIME (application/pdf, ...)
  isArchived        Boolean                 @default(false) // Đã lưu trữ

  // Department & processor relations
  departmentId Int?
  department   Department? @relation("DocumentDepartment", fields: [departmentId], references: [id])
  processorId  Int?
  processor    User?       @relation("DocumentProcessor", fields: [processorId], references: [id])

  // Confidentiality & urgency relations
  confidentiality Confidentiality? @relation(fields: [confidentialityId], references: [id])
  urgency         Urgency?         @relation(fields: [urgencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?

  createdByUser     User?                @relation("CreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?                @relation("UpdatedBy", fields: [updatedBy], references: [id])
  incomingDocuments IncomingDocument[]
  outgoingDocuments OutgoingDocument[]
  workflows         DocumentWorkflow[]
  processors        DocumentProcessor[]
  attachments       DocumentAttachment[]

  @@index([documentStatus])
  @@index([type])
  @@index([departmentId])
  @@index([processorId])
  @@index([confidentialityId])
  @@index([urgencyId])
}

model IncomingDocument {
  id                     Int       @id @default(autoincrement())
  documentId             Int       @unique
  issuer                 String? // Cơ quan ban hành
  documentType           String? // Loại văn bản (QUYẾT ĐỊNH, CÔNG VĂN,...)
  documentNumber         String? // Số ký hiệu văn bản
  arrivalNumber          Int? // Số đến (số tự động tăng)
  signerName             String? // Họ tên người ký
  signerTitle            String? // Chức vụ người ký
  dateLetter             DateTime? // Ngày, tháng, năm văn bản
  dateReceived           DateTime // Ngày đến
  summary                String?   @db.Text // Trích yếu nội dung
  pageCount              Int? // Số trang văn bản
  urgencyId              Int? // FK -> Urgency (Độ khẩn: Thường / Khẩn / Thượng khẩn / Hỏa tốc)
  notes                  String?
  processingInstructions String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?
  urgency      Urgency?    @relation(fields: [urgencyId], references: [id])

  @@index([urgencyId])
}

model OutgoingDocument {
  id         Int @id @default(autoincrement())
  documentId Int @unique

  // Thông tin cơ bản văn bản đi
  documentType   String? // Loại văn bản (QUYẾT ĐỊNH, CÔNG VĂN,...)
  documentNumber String? // Số ký hiệu văn bản gốc
  dispatchNumber String? // Số phát hành chính thức (do văn thư cấp)
  issuanceDate   DateTime? // Ngày ban hành chính thức
  signerName     String? // Họ tên người ký
  signerTitle    String? // Chức vụ người ký
  urgencyId      Int? // FK -> Urgency (Độ khẩn)

  // Thông tin phát hành
  recipientName    String? // Tên người/cơ quan nhận
  recipientAddress String? // Địa chỉ người nhận
  recipientEmail   String? // Email người nhận
  sentDate         DateTime? // Ngày gửi/phát hành
  pageCount        Int? // Số trang

  // Workflow notes
  submittedAt  DateTime? // Thời điểm trình duyệt
  submittedBy  Int? // Người trình duyệt
  approvedAt   DateTime? // Thời điểm duyệt
  approvedBy   Int? // Người duyệt
  returnedAt   DateTime? // Thời điểm trả lại
  returnedBy   Int? // Người trả lại
  returnReason String? // Lý do trả lại
  forwardedAt  DateTime? // Thời điểm chuyển văn thư
  forwardedBy  Int? // Người chuyển văn thư
  issuedAt     DateTime? // Thời điểm phát hành
  issuedBy     Int? // Người phát hành
  recalledAt   DateTime? // Thời điểm thu hồi
  recalledBy   Int? // Người thu hồi
  recallReason String? // Lý do thu hồi
  trashedAt    DateTime? // Thời điểm đưa vào thùng rác
  trashedBy    Int? // Người đưa vào thùng rác

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  submittedByUser User?    @relation("OutgoingSubmittedBy", fields: [submittedBy], references: [id])
  approvedByUser  User?    @relation("OutgoingApprovedBy", fields: [approvedBy], references: [id])
  returnedByUser  User?    @relation("OutgoingReturnedBy", fields: [returnedBy], references: [id])
  forwardedByUser User?    @relation("OutgoingForwardedBy", fields: [forwardedBy], references: [id])
  issuedByUser    User?    @relation("OutgoingIssuedBy", fields: [issuedBy], references: [id])
  recalledByUser  User?    @relation("OutgoingRecalledBy", fields: [recalledBy], references: [id])
  trashedByUser   User?    @relation("OutgoingTrashedBy", fields: [trashedBy], references: [id])
  urgency         Urgency? @relation(fields: [urgencyId], references: [id])

  @@index([urgencyId])
}

model DocumentProcessor {
  id            Int           @id @default(autoincrement())
  documentId    Int
  userId        Int
  processorType ProcessorType
  createdAt     DateTime      @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId, userId, processorType])
}

model DocumentAttachment {
  id         Int      @id @default(autoincrement())
  documentId Int
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model WorkflowStep {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  stepOrder   Int      @default(1)
  roleName    String? // Optional: restrict this step to a specific role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflows DocumentWorkflow[]
}

model DocumentWorkflow {
  id             Int            @id @default(autoincrement())
  documentId     Int
  workflowStepId Int
  userId         Int?
  status         WorkflowStatus @default(PENDING)
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String
  entityType String?
  entityId   Int?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}
