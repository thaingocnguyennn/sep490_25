# ─── PostgreSQL (docker-compose) ──────────────────────────────────────────────
# Consumed by docker-compose.yml and docker-compose.backup.yml via
# `env_file:`. Change these to anything you like; they only need to match
# the DATABASE_URL inside backend/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dms_db
POSTGRES_PORT=5432
